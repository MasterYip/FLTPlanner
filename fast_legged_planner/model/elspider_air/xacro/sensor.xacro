<?xml version="1.0"?>

<robot name="elspider_air" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- root link can not have interia, so add this link and joint -->
    <link name="sensorSupport">
        <inertial>
            <origin xyz="0 0 0.0" rpy="0 0 0"/>
            <!-- FIXME: need to update mass -->
            <mass value="0.0"/>
            <!-- FIXME: need to update ixx,iyy and izz -->
            <inertia    ixx="0.0" ixy="0.0" ixz="0.0"
                        iyy="0.0" iyz="0.0" izz="0.0}"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://robot/urdf/elspider_air/meshes/sensors/sensorSupport.STL"/>
            </geometry>
            <material name="">
                <color rgba="1 1 1 1" />
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://robot/urdf/elspider_air/meshes/sensors/sensorSupport.STL"/>
            </geometry>
        </collision>
    </link>

    <joint name="sensorSupport_joint" type="fixed">
        <parent link="trunk"/>
        <child link="sensorSupport"/>
        <origin xyz="-0.26 0 0.15" rpy="-1.5708 0 0"/>
    </joint>

    <xacro:include filename="$(find robot)/urdf/sensors/VLP-16/xacro/VLP-16.urdf.xacro"/>
    <xacro:VLP-16 parent="sensorSupport" name="velodyneLidar" topic="/elspider_air/velodyne_points2" organize_cloud="${organize_cloud}" hz="10" samples="220" gpu="${gpu}">
        <origin xyz="0 -0.13 0" rpy="1.5708 1.5708 -0.25" />
    </xacro:VLP-16>

    <xacro:include filename="$(find realsense_ros_gazebo)/xacro/tracker.xacro"/>
    <xacro:realsense_T265 sensor_name="T265_camera" parent_link="sensorSupport" rate="30.0">
    <origin rpy="-1.5708 0 ${3.14159 - 0.395}" xyz="-0.12 -0.04 0"/>
    </xacro:realsense_T265>

</robot>
