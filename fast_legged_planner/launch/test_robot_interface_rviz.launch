<launch>
    <param name="robot_description" command="$(find xacro)/xacro $(find hexapod_robot_assets)/model/elspider_air/xacro/robot.xacro"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen" />
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_legged_planner)/config/test_robot_interface_rviz.rviz" output="screen"/>
    <node pkg="fast_legged_planner" type="test_robot_interface_rviz" name="test_robot_interface_rviz" output="screen"/>
</launch>
