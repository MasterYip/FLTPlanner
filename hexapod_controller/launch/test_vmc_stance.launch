<launch>

    <arg name="sim" default="false" />

    <node pkg="hexapod_controller" type="vmc_controller_node" name="vmc_controller_node" output="screen">
        <rosparam command="load" file="$(find hexapod_controller)/config/vmc_config.yaml" />
        <param name="sim" value="$(arg sim)" />
    </node>
    <node pkg="hexapod_controller" type="test_vmc_stance" name="test_vmc_stance" output="screen">
        <rosparam command="load" file="$(find hexapod_controller)/config/test_vmc_stance.yaml" />
    </node>
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find hexapod_controller)/config/default.rviz" />

    <node pkg="joy" type="joy_node" name="joy_node" output="screen" clear_params="true" required="true" if="$(eval sim==1)">
        <param name="dev" value="/dev/input/js0"/>
        <!-- udevadm monitor -->
        <param name="dev_ff" value="/dev/input/event20"/>
        <!-- maintain a fixed send&receive frequency helps force feedback control (100Hz) -->
        <param name="coalesce_interval" value="0.01"/>
        <param name="autorepeat_rate" value="100"/>
        <param name="default_trig_val" value="true"/>
    </node>

    <!-- HexapodElevationMapping -->
    <include file="$(find hexapod_elevation_mapping)/launch/elspider_air_mapping.launch">
        <arg name="module_name" value="HexPercept3" />
        <arg name="sim" value="$(arg sim)" />
        <arg name="elevation_map_raw_topic_name" value="/grid_map" />
        <arg name="rviz_gui" value="false" />
        <!-- FIXME: base name conflict with HexapodSoftware -->
        <arg name="world_frame_name" value="odom"/>
        <arg name="base_frame_name" value="base"/>
    </include>
</launch>