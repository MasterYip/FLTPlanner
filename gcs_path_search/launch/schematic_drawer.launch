<launch>
    <!-- schematic_drawer -->
    <!-- Settings -->
    <arg name="with_robot" value="true" />
    <arg name="with_ceiling" value="false" />
    <arg name="max_height" value="0.0" />
    <!-- Ground & Ceiling (must be of the same size) -->
    <arg name="grid_map_file" value="$(find fast_legged_planner)/data/traj_opt_demo/2-Barrier-ground.png" />
    <arg name="grid_map_file_ceiling" value="$(find fast_legged_planner)/data/traj_opt_demo/2-Barrier-ceiling.png" />
    <arg name="elevation_layer" value="elevation" />
    <arg name="ceiling_layer" value="ceiling" />

    <!-- Params FIXME? -->
    <param name="grid_map_topic" value="grid_map" />
    <param name="point_cloud_topic" value="point_cloud" />
    <param name="elevation_layer" value="$(arg elevation_layer)" />
    <param name="ceiling_layer" value="$(arg ceiling_layer)" />

    <!-- GridMap -->
    <node pkg="fast_legged_planner" type="image_publisher.py" name="image_publisher" output="screen">
        <param name="image_path" value="$(arg grid_map_file)" />
        <param name="topic" value="~image" />
    </node>
    <group if="$(arg with_ceiling)">
        <node pkg="fast_legged_planner" type="image_publisher.py" name="image_ceiling_publisher" output="screen">
            <param name="image_path" value="$(arg grid_map_file_ceiling)" />
            <param name="topic" value="~image" />
        </node>
    </group>
    <node pkg="fast_legged_planner" type="image_to_gridmap" name="image_to_gridmap" output="screen">
        <param name="with_ceiling" value="$(arg with_ceiling)" />
        <param name="image_topic" value="/image_publisher/image" />
        <param name="image_ceiling_topic" value="/image_ceiling_publisher/image" />
        <param name="resolution" value="0.05" />
        <param name="map_frame_id" value="odom" />
        <param name="min_height" value="0" />
        <param name="max_height" value="$(arg max_height)" />
        <remap from="/elevation" to="/$(arg elevation_layer)"/>
        <remap from="/ceiling" to="/$(arg ceiling_layer)"/>
    </node>

    <!-- sdf_pub for SDF visualization (pointcloud) -->
    <node pkg="fast_legged_planner" type="sdf_pub" name="sdf_pub" output="screen"/>

    <group if="$(arg with_robot)">
        <!-- Robot related -->
        <param name="robot_description" command="$(find xacro)/xacro $(find hexapod_robot_assets)/model/elspider_air/xacro/robot.xacro" />
        <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen" />
        <node pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" name="joint_state_publisher_gui" output="screen" />
        <arg name="robot_tf" default="-0.5 0 0.16 0 0 0" />
        <node pkg="tf2_ros" type="static_transform_publisher" name="module2lidar" args="$(arg robot_tf) odom base"/>
        <!-- Rviz -->
        <node pkg="rviz" type="rviz" name="rviz" args="-d $(find gcs_path_search)/config/schematic_drawer.rviz" output="screen" />
    </group>
    <group unless="$(arg with_robot)">
        <!-- Rviz -->
        <node pkg="rviz" type="rviz" name="rviz" args="-d $(find gcs_path_search)/config/schematic_drawer.rviz" output="screen" />
    </group>

    <node pkg="gcs_path_search" type="schematic_drawer" name="schematic_drawer" output="screen">
        <!-- node parameters -->
        <rosparam file="$(find gcs_path_search)/config/cvx_trajopt_params.yaml" command="load" />
    </node>

    <!-- RQT Reconf -->
    <!-- <node pkg="rqt_reconfigure" type="rqt_reconfigure" name="rqt_reconfigure" output="screen" /> -->

</launch>