<launch>
    <!-- Unitree A1 State Sequence Planner -->

    <!-- Demo Select -->
    <!-- 1_stairs / 2_stairs / 3_quincuncial_piles / 3_timber_pile / 3_timber_pile_hw
    / 4_barrier / 4_barrier_vague / 4_ushape_barrier
    / 5_channel / 6_fractal-->
    <arg name="demo_name" default="4_ushape_barrier" />
    <!-- Planner Select -->
    <!-- height_clear_planner -->
    <!-- fec_planner -->
    <!-- minco_cfg_planner -->
    <!-- flt_planner / flt_cfg_planner / flt_cfg_planner_fast / flt_cfg_groundtruth-->
    <!-- flt_cfg_planner_keypoint /  flt_cfg_planner_conv (for reahcability check benchmark)-->
    <!-- rrt_planner / rrt_cfg_planner -->
    <!-- stomp_planner / stomp_cfg_planner / stomp_cfg_groundtruth-->
    <arg name="planner_cfg" default="flt_cfg_planner_conv_a1" />

    <!-- Settings -->
    <!-- Gazebo / Hardware / Dummy -->
    <arg name="sim" default="true" />
    <!-- keyboard / PS5 -->
    <arg name="teleop_type" default="keyboard" />
    <!-- UnitreeA1Dummy / UnitreeA1ROS (for future hardware integration) -->
    <arg name="robot_interface_type" default="UnitreeA1Dummy" />
    <!-- GridMap -->
    <arg name="with_ceiling" default="false"/>
    <arg name="ground_ceiling_boundary" default="0.3" />
    <!-- ROS bag record (under ~/.ros) -->
    <arg name="rosbag_record" default="false" />
    <!-- Rviz visualization -->
    <arg name="rviz_gui" default="true" />
    <!-- Output: screen / log -->
    <arg name="output" default="screen" />

    <!-- Launch -->
    <!-- Config -->
    <arg name="auto_benchmark" default="false" />
    <arg name="grid_map_topic" value="/grid_map" />
    <arg name="grid_map_topic_ceiling" value="/grid_map_ceiling" />
    <!-- Map File (Images) -->
    <arg name="grid_map_file" value="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/terrain_ground.png" />
    <arg name="grid_map_file_ceiling" value="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/terrain_ceiling.png" />
    <!-- Map Def (Timber Pile Generation) -->
    <arg name="grid_map_def" value="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/map_def.yaml" />

    <!-- GridMap -->
    <arg name="use_fake_map" value="$(eval robot_interface_type == 'UnitreeA1Dummy')" />
    <group if="$(eval use_fake_map == 1)">
        <node pkg="legged_traj_plan_examples" type="image_publisher.py" name="image_publisher" output="$(arg output)">
            <param name="image_path" value="$(arg grid_map_file)" />
            <param name="map_def_path" value="$(arg grid_map_def)" />
            <param name="topic" value="~image" />
            <rosparam command="load" file="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/gridmap_config.yaml" />
        </node>
        <group if="$(arg with_ceiling)">
            <node pkg="legged_traj_plan_examples" type="image_ceiling_publisher.py" name="image_ceiling_publisher" output="$(arg output)">
                <param name="image_path" value="$(arg grid_map_file_ceiling)" />
                <param name="map_def_path" value="$(arg grid_map_def)" />
                <param name="topic" value="~image" />
                <rosparam command="load" file="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/gridmap_config.yaml" />
            </node>
        </group>
        <node pkg="legged_traj_plan_examples" type="image_to_gridmap" name="image_to_gridmap" output="$(arg output)">
            <param name="with_ceiling" value="$(arg with_ceiling)" />
            <param name="image_topic" value="/image_publisher/image" />
            <param name="image_ceiling_topic" value="/image_ceiling_publisher/image" />
            <param name="map_frame_id" value="odom" />
            <param name="grid_map_topic" value="$(arg grid_map_topic)" />
            <rosparam command="load" file="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/gridmap_config.yaml" />
        </node>
    </group>

    <!-- Unitree A1 State Sequence Planner -->
    <node pkg="legged_traj_plan_examples" type="unitree_a1_state_sequence_planner" name="unitree_a1_state_sequence_planner" output="$(arg output)">
        <!-- Robot Interface -->
        <rosparam command="load" file="$(find legged_traj_plan)/config/robot_interface.yaml"/>
        <param name="robotInterface" value="$(arg robot_interface_type)" />
        <param name="$(arg robot_interface_type)/sim" value="$(arg sim)" />
        <!-- Planner Config -->
        <rosparam command="load" file="$(find legged_traj_plan)/config/swing_traj_planner/$(arg planner_cfg).yaml"/>
        <rosparam command="load" file="$(find legged_traj_plan_examples)/config/planner/unitree_a1_state_sequence_planner.yaml" if="$(eval auto_benchmark == 0)"/>
        <rosparam command="load" file="$(find legged_traj_plan_examples)/config/planner/unitree_a1_state_sequence_planner_autobenchmark.yaml" if="$(eval auto_benchmark == 1)"/>
        <param name="A1StateSequencePlanner/demoPath" value="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/" />
        <param name="A1StateSequencePlanner/execSavedStates" value="false" unless="$(eval robot_interface_type == 'UnitreeA1Dummy')"/>
        <!-- Perception Interface -->
        <rosparam command="load" file="$(find legged_traj_plan)/config/perception_interface.yaml"/>
        <!-- Perception Interface Config Override -->
        <rosparam command="load" file="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/gridmap_config.yaml" />
    </node>

    <!-- Robot related -->
    <param name="robot_description" command="$(find xacro)/xacro $(find robot_assets)/model/a1/urdf/a1.urdf" if="$(eval robot_interface_type == 'UnitreeA1Dummy')"/>
    <!-- Load robot model if sim is False -->
    <param name="robot_description" command="$(find xacro)/xacro $(find robot_assets)/model/a1/urdf/a1.urdf" if="$(eval sim == 0)"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="$(arg output)" />
    <!-- Shadow Robot -->
    <group ns="shadow">
        <param name="robot_description" command="$(find xacro)/xacro $(find robot_assets)/model/a1/urdf/a1.urdf ns:=shadow"/>
        <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="$(arg output)" />
    </group>

    <group if="$(arg rviz_gui)">
        <!-- Rviz -->
        <node pkg="rviz" type="rviz" name="rviz_unitree_a1" args="-d $(find legged_traj_plan_examples)/config/rviz/unitree_a1_state_sequence_planner.rviz" output="$(arg output)" unless="$(eval use_fake_map)"/>
        <node pkg="rviz" type="rviz" name="rviz_unitree_a1_fake" args="-d $(find legged_traj_plan_examples)/config/rviz/unitree_a1_state_sequence_planner_fake.rviz" output="$(arg output)" if="$(eval use_fake_map)"/>

        <!-- Teleop -->
        <group if="$(eval teleop_type == 'keyboard')">
            <include file="$(find legged_traj_plan_examples)/launch/key_teleop2.launch">
                <arg name="topic_name" value="/cmd_vel" />
                <arg name="scale_linear" value="0.3" />
                <arg name="scale_angular" value="0.1" />
            </include>
        </group>
        <group if="$(eval teleop_type == 'PS5')">
            <node pkg="joy" type="joy_node" name="joy_node" output="$(arg output)" clear_params="true" required="true" if="$(eval sim == 1)">
                <param name="dev" value="/dev/input/js0"/>
                <param name="dev_ff" value="/dev/input/event20"/>
                <param name="coalesce_interval" value="0.01"/>
                <param name="autorepeat_rate" value="100"/>
                <param name="default_trig_val" value="true"/>
            </node>
            <node pkg="legged_traj_plan_examples" type="joy_teleop.py" name="joy_teleop" output="$(arg output)">
                <param name="cmd_topic" value="/cmd_vel" />
                <param name="joy_topic" value="/joy" />
            </node>
        </group>
    </group>

    <!-- ROS bag record -->
    <group if="$(eval rosbag_record == 1)">
        <node pkg="rosbag" type="record" name="rosbag_record" args="
            /tf /tf_static 
            /grid_map 
            /unitree_a1_state_sequence_planner/a1_visualizer_markers 
            /swing_traj_planner_vis 
            /a1/foot_state_fdb 
            -o unitree_a1-$(arg demo_name)-$(arg planner_cfg)" output="$(arg output)" />
    </group>

</launch>