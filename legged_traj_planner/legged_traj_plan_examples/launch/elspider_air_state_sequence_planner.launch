<launch>
    <!-- ElSpider Air State Sequence Planner -->

    <!-- Demo Select (If sim = false, choose hardware) -->
    <!-- 1_stairs / 2_stairs / 3_quincuncial_piles 
    / 4_barrier / 4_barrier_vague / 4_ushape_barrier
    / 5_channel / 6_fractal-->
    <arg name="demo_name" default="4_ushape_barrier" />
    <!-- Planner Select -->
    <!-- height_clear_planner -->
    <!-- minco_cfg_planner -->
    <!-- flt_planner / flt_cfg_planner / flt_cfg_planner_fast-->
    <!-- rrt_planner / rrt_cfg_planner -->
    <!-- stomp_planner / stomp_cfg_planner -->
    <arg name="planner_cfg" default="flt_cfg_planner" />

    <!-- Settings -->
    <!-- Gazebo / Hardware -->
    <arg name="sim" default="true" />
    <!-- keyboard / PS5 -->
    <arg name="teleop_type" default="keyboard" />
    <!-- ElSpiderAirROS / ElSpiderAirROSVMC / ElSpiderAirDummy -->
    <arg name="robot_interface_type" default="ElSpiderAirROS" />
    <!-- Optitrack -->
    <arg name="use_optitrack" default="false" />
    <!-- GridMap -->    <!-- Ground & Ceiling (must be of the same size) -->
    <arg name="with_ceiling" default="true"/>
    <!-- ROS bag record (under ~/.ros) -->
    <arg name="rosbag_record" default="false" />
    <!-- Rviz visualization -->
    <arg name="rviz_gui" default="true" />
    <!-- Output: screen / log -->
    <arg name="output" default="screen" />

    <!-- Launch -->
    <!-- Config -->
    <arg name="auto_benchmark" default="false" />
    <arg name="grid_map_topic" value="/grid_map" />
    <arg name="grid_map_file" value="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/terrain_ground.png" />
    <arg name="grid_map_file_ceiling" value="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/terrain_ceiling.png" />
    <!-- GridMap -->
    <group if="$(eval robot_interface_type == 'ElSpiderAirDummy')">
        <node pkg="legged_traj_plan_examples" type="image_publisher.py" name="image_publisher" output="$(arg output)">
            <param name="image_path" value="$(arg grid_map_file)" />
            <param name="topic" value="~image" />
        </node>
        <group if="$(arg with_ceiling)">
            <node pkg="legged_traj_plan_examples" type="image_publisher.py" name="image_ceiling_publisher" output="$(arg output)">
                <param name="image_path" value="$(arg grid_map_file_ceiling)" />
                <param name="topic" value="~image" />
            </node>
        </group>
        <node pkg="legged_traj_plan_examples" type="image_to_gridmap" name="image_to_gridmap" output="$(arg output)">
            <param name="with_ceiling" value="$(arg with_ceiling)" />
            <param name="image_topic" value="/image_publisher/image" />
            <param name="image_ceiling_topic" value="/image_ceiling_publisher/image" />
            <param name="map_frame_id" value="odom" />
            <param name="grid_map_topic" value="$(arg grid_map_topic)" />
            <rosparam command="load" file="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/gridmap_config.yaml" />
        </node>
    </group>

    <group unless="$(eval robot_interface_type == 'ElSpiderAirDummy')">
        <!-- Vrpn Client ROS -->
        <include file="$(find vrpn_client_ros)/launch/sample.launch" if="$(eval use_optitrack == 1)"/>
        <!-- HexapodElevationMapping -->
        <include file="$(find hexapod_elevation_mapping)/launch/elspider_air_mapping.launch">
            <arg name="module_name" value="HexPercept3_optitrack" if="$(eval use_optitrack == 1)"/>
            <arg name="module_name" value="HexPercept3" if="$(eval use_optitrack == 0)"/>
            <arg name="sim" value="$(arg sim)" />
            <arg name="elevation_map_raw_topic_name" value="$(arg grid_map_topic)" />
            <arg name="rviz_gui" value="false" />
            <!-- FIXME: base name conflict with HexapodSoftware -->
            <arg name="world_frame_name" value="odom"/>
            <arg name="base_frame_name" value="base"/>
        </include>
    </group>

    <!-- State Sequence Planner -->
    <node pkg="legged_traj_plan_examples" type="elspider_air_state_sequence_planner" name="elspider_air_state_sequence_planner" output="$(arg output)">
        <!-- Robot Interface -->
        <rosparam command="load" file="$(find legged_traj_plan)/config/robot_interface.yaml"/>
        <param name="robotInterface" value="ElSpiderAirROS" if="$(eval robot_interface_type == 'ElSpiderAirROS')"/>
        <param name="robotInterface" value="ElSpiderAirROSVMC" if="$(eval robot_interface_type == 'ElSpiderAirROSVMC')"/>
        <param name="robotInterface" value="ElSpiderAirDummy" if="$(eval robot_interface_type == 'ElSpiderAirDummy')"/>
        <param name="ElSpiderAirROS/sim" value="$(arg sim)" />
        <!-- Planner Config -->
        <rosparam command="load" file="$(find legged_traj_plan)/config/swing_traj_planner/$(arg planner_cfg).yaml"/>
        <rosparam command="load" file="$(find legged_traj_plan_examples)/config/planner/state_sequence_planner.yaml" if="$(eval auto_benchmark == 0)"/>
        <rosparam command="load" file="$(find legged_traj_plan_examples)/config/planner/state_sequence_planner_autobenchmark.yaml" if="$(eval auto_benchmark == 1)"/>
        <param name="StateSequencePlanner/demoPath" value="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/" />
        <param name="StateSequencePlanner/execSavedStates" value="false" unless="$(eval robot_interface_type == 'ElSpiderAirDummy')"/>
        <!-- Perception Interface -->
        <rosparam command="load" file="$(find legged_traj_plan)/config/perception_interface.yaml"/>
        <!-- Perception Interface Config Override -->
        <rosparam command="load" file="$(find legged_traj_plan_examples)/demos/$(arg demo_name)/gridmap_config.yaml" />
    </node>

    <!-- Robot related -->
    <param name="robot_description" command="$(find xacro)/xacro $(find hexapod_robot_assets)/model/elspider_air/xacro/robot.xacro" if="$(eval robot_interface_type == 'ElSpiderAirDummy')"/>
    <!-- Load robot model if sim is False -->
    <param name="robot_description" command="$(find xacro)/xacro $(find hexapod_robot_assets)/model/elspider_air/xacro/robot.xacro" if="$(eval sim == 0)"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="$(arg output)" />
    <!-- Shadow Robot -->
    <group ns="shadow">
        <param name="robot_description" command="$(find xacro)/xacro $(find hexapod_robot_assets)/model/elspider_air/xacro/robot.xacro ns:=shadow"/>
        <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="$(arg output)" />
    </group>


    <group if="$(eval robot_interface_type == 'ElSpiderAirROSVMC')">
        <!-- VMC Controller -->
        <node pkg="hexapod_controller" type="vmc_controller_node" name="vmc_controller_node" output="$(arg output)">
            <rosparam command="load" file="$(find hexapod_controller)/config/vmc_config.yaml" if="$(eval sim==0)" />
            <rosparam command="load" file="$(find hexapod_controller)/config/vmc_config_sim.yaml" if="$(eval sim==1)" />
            <param name="sim" value="$(arg sim)" />
        </node>
    </group>

    <group if="$(arg rviz_gui)">
        <!-- Rviz -->
        <node pkg="rviz" type="rviz" name="rviz_elspider_air" args="-d $(find legged_traj_plan_examples)/config/rviz/elspider_air_state_sequence_planner.rviz" output="$(arg output)" unless="$(eval robot_interface_type == 'ElSpiderAirDummy')"/>
        <node pkg="rviz" type="rviz" name="rviz_elspider_air_fake" args="-d $(find legged_traj_plan_examples)/config/rviz/elspider_air_state_sequence_planner_fake.rviz" output="$(arg output)" if="$(eval robot_interface_type == 'ElSpiderAirDummy')"/>

        <!-- Teleop -->
        <group if="$(eval teleop_type == 'keyboard')">
            <include file="$(find legged_traj_plan_examples)/launch/key_teleop.launch">
                <arg name="topic_name" value="/cmd_vel" />
            </include>
        </group>
        <group if="$(eval teleop_type == 'PS5')">
            <node pkg="joy" type="joy_node" name="joy_node" output="$(arg output)" clear_params="true" required="true" if="$(eval sim == 1)">
                <param name="dev" value="/dev/input/js0"/>
                <!-- udevadm monitor -->
                <param name="dev_ff" value="/dev/input/event20"/>
                <!-- maintain a fixed send&receive frequency helps force feedback control (100Hz) -->
                <param name="coalesce_interval" value="0.01"/>
                <param name="autorepeat_rate" value="100"/>
                <param name="default_trig_val" value="true"/>
            </node>
            <node pkg="legged_traj_plan_examples" type="joy_teleop.py" name="joy_teleop" output="$(arg output)">
                <param name="cmd_topic" value="/cmd_vel" />
                <param name="joy_topic" value="/joy" />
            </node>
        </group>
    </group>

    <!-- ROS bag record -->
    <group if="$(eval rosbag_record == 1)">
        <node pkg="rosbag" type="record" name="rosbag_record" args="
            /tf /tf_static 
            /grid_map 
            /elspider_air_state_sequence_planner/grid_map_trav_test 
            /swing_traj_planner_vis 
            /hexapod/foot_state_fdb 
            -o elspider_air-$(arg demo_name)-$(arg planner_cfg)" output="$(arg output)" />
    </group>

</launch>