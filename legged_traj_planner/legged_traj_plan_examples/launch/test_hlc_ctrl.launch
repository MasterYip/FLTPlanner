<launch>
    <arg name="sim" default="false"/>
    <param name="robot_description" command="$(find xacro)/xacro $(find robot_assets)/model/elspider_air/xacro/robot.xacro"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen" />
    <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find legged_traj_plan_examples)/config/rviz/test_robot_interface_rviz.rviz" output="screen"/> -->
    <node pkg="legged_traj_plan_examples" type="test_hlc_ctrl" name="test_hlc_ctrl" output="screen">
        <rosparam command="load" file="$(find legged_traj_plan_examples)/config/test_hlc_ctrl_sim.yaml" if="$(eval sim==1)"/>
        <rosparam command="load" file="$(find legged_traj_plan_examples)/config/test_hlc_ctrl.yaml" if="$(eval sim==0)"/>
    </node>
</launch>
